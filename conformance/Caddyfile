suite.localhost {
	tls /etc/caddy/certs/suite.localhost.pem /etc/caddy/certs/suite.localhost-key.pem

	@wrong_mtls path /test-mtls/*
	handle @wrong_mtls {
		reverse_proxy suite:8080 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
			header_up X-Ssl-Protocol {tls_version}
			header_up X-Ssl-Cipher {tls_cipher}
			header_up X-Test-Mtls-Called-On-Wrong-Host true
		}
	}

	handle {
		reverse_proxy suite:8080 {
			header_up X-Forwarded-Proto https
			header_up X-Forwarded-Port 443
			header_up X-Ssl-Protocol {tls_version}
			header_up X-Ssl-Cipher {tls_cipher}
		}
	}
}

suite.localhost:8444 {
	tls /etc/caddy/certs/suite.localhost.pem /etc/caddy/certs/suite.localhost-key.pem {
		client_auth {
			mode request
		}
	}

	reverse_proxy suite:8080 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Port 8444
		header_up X-Ssl-Protocol {tls_version}
		header_up X-Ssl-Cipher {tls_cipher}
		header_up X-Ssl-Cert {http.request.tls.client.certificate_pem}
		header_up X-Ssl-Cert "[\r\n]+" " "
	}
}

